APP_NAME=Voice Inventory Agent API
APP_ENV=local
DEBUG=false
DATABASE_ECHO=false

# Neon PostgreSQL async connection URL.
DATABASE_URL=postgresql+asyncpg://user:password@host/database?ssl=require

# Separate database for integration tests (e.g. a dedicated Neon "test" branch).
# Integration tests drop and recreate tables here, so it must NOT be the runtime
# DATABASE_URL. Use ?ssl=require (asyncpg does not understand ?sslmode=require).
# When this is unset, integration tests under tests/integration/ are skipped.
TEST_DATABASE_URL=postgresql+asyncpg://user:password@host/test_database?ssl=require
